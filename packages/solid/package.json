{
  "name": "@gistui/solid",
  "version": "0.2.1",
  "description": "GistUI for Solid (and SolidStart, TanStack Start with Solid): a <GistUI> component that renders streamed GistUI programs, with the default components built in and your own Solid components for any name.",
  "keywords": [
    "gistui",
    "solid",
    "solidjs",
    "components",
    "streaming",
    "generative-ui"
  ],
  "license": "MIT",
  "homepage": "https://gistui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GistUI/GistUI.git",
    "directory": "packages/solid"
  },
  "bugs": "https://github.com/GistUI/GistUI/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "gistui-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "bun test --conditions=browser",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gistui/vanilla": "workspace:*",
    "@gistui/core": "workspace:*",
    "@gistui/headless": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.9"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.0",
    "@types/bun": "^1.3.0",
    "happy-dom": "^20.14.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
