{
  "name": "@gistui/server",
  "version": "0.1.0",
  "description": "GistUI on the model side: system prompts, stream parsing, validation and repair (Node, Edge, Bun, Workers).",
  "keywords": [
    "gistui",
    "llm",
    "prompt",
    "validation",
    "repair",
    "generative-ui"
  ],
  "license": "MIT",
  "homepage": "https://gistui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GistUI/GistUI.git",
    "directory": "packages/server"
  },
  "bugs": "https://github.com/GistUI/GistUI/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "gistui-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gistui/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
