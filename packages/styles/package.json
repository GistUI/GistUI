{
  "name": "@gistui/styles",
  "version": "0.1.0",
  "description": "GistUI design system: one plain-CSS stylesheet and tokens.",
  "keywords": [
    "gistui",
    "css",
    "design-system",
    "generative-ui"
  ],
  "license": "MIT",
  "type": "module",
