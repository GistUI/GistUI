root = Stack(headerCard, kpiRow, chartsRow, featuresCard, revenueCard, gap:lg)
headerCard = Card(Header("Product Analytics Dashboard", "Usage, acquisition, feature adoption, and revenue trends"))
kpiRow = Grid(kpi1, kpi2, kpi3, kpi4, cols:4)
kpi1 = Card("**Monthly Active Users (MAU)**", "## 128,400", Text("+6.2% vs last month", size:sm), v:sunk)
kpi2 = Card("**New Users (30d)**", "## 24,950", Text("+3.1% vs last 30d", size:sm), v:sunk)
kpi3 = Card("**MRR**", "## $412,000", Text("+4.4% MoM", size:sm), v:sunk)
kpi4 = Card("**ARR**", "## $4.94M", Text("+18.7% YoY", size:sm), v:sunk)
chartsRow = Grid(mauCard, acquisitionCard, cols:2)
mauCard = Card(Header("Monthly Active Users", "Last 12 months", size:sm), Chart(mauData, type:bar, x:"Month", y:"Users"))
acquisitionCard = Card(Header("User Acquisition", "Share of new users (last 30 days)", size:sm), Chart(acqData, type:donut), Text("Tip: Track CAC and conversion rate by channel to explain mix shifts.", size:sm))
featuresCard = Card(Header("Top Features", "Adoption and engagement (last 30 days)", size:sm), Table(featureData))
revenueCard = Card(Header("Revenue Trend", "MRR and ARR (last 12 months)", size:sm), Chart(revData, type:line, x:"Month", y:"USD"), Text("ARR shown as 12×MRR for directional tracking; replace with contracted ARR if you track annual commitments.", size:sm))
