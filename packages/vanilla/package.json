{
  "name": "@gistui/vanilla",
  "version": "0.1.0",
  "description": "GistUI for vanilla JavaScript: mount a streamed GistUI program into any element, with the default components as plain DOM and no framework. The base for @gistui/vue, @gistui/svelte and @gistui/solid.",
  "keywords": [
    "gistui",
    "vanilla",
    "dom",
    "renderer",
    "streaming",
    "generative-ui"
  ],
  "license": "MIT",
  "homepage": "https://gistui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GistUI/gistui.git",
    "directory": "packages/vanilla"
  },
  "bugs": "https://github.com/GistUI/gistui/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "gistui-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "gistui-source": "./src/ui.ts",
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gistui/catalog": "workspace:*",
    "@gistui/core": "workspace:*",
    "@gistui/headless": "workspace:*",
    "@gistui/styles": "workspace:*",
    "@gistui/widgets": "workspace:*",
    "@internationalized/date": "^3.12.4",
    "@zag-js/accordion": "1.44.0",
    "@zag-js/combobox": "1.44.0",
    "@zag-js/date-picker": "1.44.0",
    "@zag-js/radio-group": "1.44.0",
    "@zag-js/select": "1.44.0",
    "@zag-js/vanilla": "1.44.0",
    "katex": "^0.16",
    "mermaid": "^11"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.0",
    "@types/bun": "^1.3.0",
    "@types/katex": "^0.16.8",
    "happy-dom": "^20.14.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
