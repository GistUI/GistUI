{
  "name": "@gistui/chat",
  "version": "0.1.0",
  "description": "GistUI chat: a headless chat store, model adapters, thread storage and React chat layouts.",
  "keywords": [
    "gistui",
    "chat",
    "llm",
    "ai-sdk",
    "generative-ui"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "gistui-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "gistui-source": "./src/react.tsx",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./chat.css": "./src/chat.css"
  },
  "files": [
    "dist",
    "src/chat.css"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gistui/core": "workspace:*",
    "@gistui/server": "workspace:*",
    "@gistui/widgets": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.0",
    "@happy-dom/global-registrator": "^20.14.0",
    "@gistui/react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "@gistui/react": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
