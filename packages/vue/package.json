{
  "name": "@gistui/vue",
  "version": "0.1.0",
  "description": "GistUI for Vue 3.5+: a <GistUI> component that renders streamed GistUI programs, with the default components built in and your own Vue components for any name.",
  "keywords": [
    "gistui",
    "vue",
    "components",
    "streaming",
    "generative-ui"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "gistui-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gistui/vanilla": "workspace:*",
    "@gistui/core": "workspace:*",
    "@gistui/headless": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.0",
    "@types/bun": "^1.3.0",
    "happy-dom": "^20.14.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
