{
  "name": "@gistui/react",
  "version": "0.2.1",
  "description": "GistUI React renderer and default components.",
  "keywords": [
    "gistui",
    "react",
    "components",
    "streaming",
    "llm",
    "generative-ui"
  ],
  "license": "MIT",
  "homepage": "https://gistui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GistUI/GistUI.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/GistUI/GistUI/issues",
  "type": "module",
  "sideEffects": [
    "./src/prompt.ts",
    "./dist/prompt.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "gistui-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "gistui-source": "./src/ui.ts",
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./prompt": {
      "gistui-source": "./src/prompt.ts",
      "types": "./dist/prompt.d.ts",
      "import": "./dist/prompt.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gistui/catalog": "workspace:*",
    "@gistui/core": "workspace:*",
    "@gistui/headless": "workspace:*",
    "@gistui/styles": "workspace:*",
    "@gistui/widgets": "workspace:*",
    "@internationalized/date": "^3.12.4",
    "@zag-js/accordion": "^1.44.0",
    "@zag-js/checkbox": "^1.44.0",
    "@zag-js/combobox": "1.44.0",
    "@zag-js/date-picker": "1.44.0",
    "@zag-js/radio-group": "1.44.0",
    "@zag-js/react": "^1.44.0",
    "@zag-js/select": "^1.44.0",
    "@zag-js/switch": "^1.44.0",
    "@zag-js/tabs": "^1.44.0",
    "katex": "^0.16",
    "mermaid": "^11"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.0",
    "@types/bun": "^1.3.0",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8",
    "ajv-formats": "^3",
    "happy-dom": "^20.14.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "zod": "^4.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
