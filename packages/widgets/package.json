{
  "name": "@gistui/widgets",
  "version": "0.1.0",
  "description": "GistUI framework-free DOM widgets: SVG chart engine and streaming Markdown.",
  "keywords": [
    "gistui",
    "charts",
    "markdown",
    "generative-ui"
  ],
  "license": "MIT",
  "homepage": "https://gistui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GistUI/GistUI.git",
    "directory": "packages/widgets"
  },
  "bugs": "https://github.com/GistUI/GistUI/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "gistui-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chart": {
      "gistui-source": "./src/chart/index.ts",
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.js"
    },
    "./markdown": {
      "gistui-source": "./src/markdown/index.ts",
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./icons": {
      "gistui-source": "./src/icons.ts",
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gistui/core": "workspace:*",
    "@gistui/headless": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "happy-dom": "^20.14.0",
    "@happy-dom/global-registrator": "^20.14.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
