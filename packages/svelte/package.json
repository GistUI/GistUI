{
  "name": "@gistui/svelte",
  "version": "0.1.0",
  "description": "GistUI for Svelte 5 (and SvelteKit): a <GistUI> component and a use:gistui action that render streamed GistUI programs, with the default components built in and your own Svelte components for any name.",
  "keywords": [
    "gistui",
    "svelte",
    "sveltekit",
    "components",
    "streaming",
    "generative-ui"
  ],
  "license": "MIT",
  "homepage": "https://gistui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GistUI/GistUI.git",
    "directory": "packages/svelte"
  },
  "bugs": "https://github.com/GistUI/GistUI/issues",
  "type": "module",
  "sideEffects": [
    "**/*.svelte"
  ],
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "gistui-source": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "bun test --conditions=browser",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gistui/vanilla": "workspace:*",
    "@gistui/core": "workspace:*",
    "@gistui/headless": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.0",
    "@types/bun": "^1.3.0",
    "happy-dom": "^20.14.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
