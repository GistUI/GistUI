{
  "name": "@gistui/headless",
  "version": "0.1.0",
  "description": "GistUI's framework-free layer, shared by React, the DOM renderer and every framework binding: engine, theme, design mapping, form schema, table, chart and readiness models.",
  "keywords": [
    "gistui",
    "headless",
    "generative-ui"
  ],
  "license": "MIT",
  "homepage": "https://gistui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GistUI/gistui.git",
    "directory": "packages/headless"
  },
  "bugs": "https://github.com/GistUI/gistui/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "gistui-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "gistui-source": "./src/engine.ts",
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./theme": {
      "gistui-source": "./src/theme.ts",
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./design": {
      "gistui-source": "./src/design.ts",
      "types": "./dist/design.d.ts",
      "import": "./dist/design.js"
    },
    "./form-schema": {
      "gistui-source": "./src/form-schema.ts",
      "types": "./dist/form-schema.d.ts",
      "import": "./dist/form-schema.js"
    },
    "./highlight": {
      "gistui-source": "./src/highlight.ts",
      "types": "./dist/highlight.d.ts",
      "import": "./dist/highlight.js"
    },
    "./url": {
      "gistui-source": "./src/url.ts",
      "types": "./dist/url.d.ts",
      "import": "./dist/url.js"
    },
    "./actions": {
      "gistui-source": "./src/actions.ts",
      "types": "./dist/actions.d.ts",
      "import": "./dist/actions.js"
    },
    "./host": {
      "gistui-source": "./src/host.ts",
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gistui/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
