{
  "name": "@gistui/core",
  "version": "0.1.0",
  "description": "GistUI Lang: streaming parser, materializer, validator and prompt generator. Zero dependencies.",
  "keywords": [
    "gistui",
    "parser",
    "streaming",
    "llm",
    "generative-ui"
  ],
  "license": "MIT",
  "homepage": "https://gistui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GistUI/gistui.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/GistUI/gistui/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "gistui-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./repair": {
      "gistui-source": "./src/repair.ts",
      "types": "./dist/repair.d.ts",
      "import": "./dist/repair.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bench": "bun ../../bench/parser/run.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "fast-check": "^4.3.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
