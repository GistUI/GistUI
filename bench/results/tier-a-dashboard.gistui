root = Stack([headerCard, kpiRow, chartsRow1, featuresCard, revenueCard], column, l)
headerCard = Card(CardHeader("Product Analytics Dashboard", "Usage, acquisition, feature adoption, and revenue trends"), card)
kpiRow = Stack([kpi1, kpi2, kpi3, kpi4], row, m, stretch, justify:start, wrap)
kpi1 = Card(TextContent("Monthly Active Users (MAU)", small-heavy), TextContent("128,400", large-heavy), TextContent("+6.2% vs last month", small), sunk)
