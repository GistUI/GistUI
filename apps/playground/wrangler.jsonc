{
	// The examples page on Cloudflare Workers: static files only, served under gistui.com/examples
	// (`bun run deploy`). The website is another Worker on gistui.com/*; this more specific route wins.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gistui-examples",
	"compatibility_date": "2026-09-01",
	// dist/examples/…, so a request for /examples/assets/x.js finds its file. Each example is a page,
	// dist/examples/<id>/index.html, served at /examples/<id>; any other address gets 404.html (the app).
	"assets": { "directory": "./dist", "html_handling": "drop-trailing-slash", "not_found_handling": "404-page" },
	"routes": [{ "pattern": "gistui.com/examples*", "zone_name": "gistui.com" }],
	"workers_dev": false
}
